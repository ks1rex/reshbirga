# ── Supabase ──────────────────────────────────────────────────────────────────
# Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here          # нужен только smoke-тесту
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here   # SECRET — не публиковать

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
# URL(ы) frontend для CORS, через запятую если несколько (без слэша на конце
# каждого) — НЕ используется для ссылок в уведомлениях, см. SITE_URL ниже.
# Локально:  http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Канонический адрес прод-сайта — используется для ссылок в Telegram-
# уведомлениях (utils/notify.js) и в GET /wallet's referral_link. Реальный
# прод — ebugubkin.ru (не GitHub Pages, у которого другой base-путь
# /Ebu.Gubkin/, см. root CLAUDE.md "Infrastructure"). Без слэша на конце.
SITE_URL=https://ebugubkin.ru

# ── Бизнес-логика ─────────────────────────────────────────────────────────────
# Через сколько часов заказ автоподтверждается (awaiting_confirmation → completed)
AUTO_CONFIRM_HOURS=24

# ── AI-модерация (опционально) ────────────────────────────────────────────────
# DeepSeek API key; если отсутствует — AI-проверка не запускается
DEEPSEEK_API_KEY=your_deepseek_api_key_here   # SECRET

# ── Почта (подтверждение/сброс пароля через SMTP Timeweb) ─────────────────────
MAIL_HOST=smtp.timeweb.ru
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=noreply@ebugubkin.ru
MAIL_PASSWORD=your_mailbox_password_here      # SECRET

# ── Личный Telegram-бот пользователей (опционально) ────────────────────────────
# Отдельный бот от TELEGRAM_BOT_TOKEN (тот — админский). Заводится через
# @BotFather; без токена и юзернейма кнопка "Подключить Telegram" на сайте
# отвечает 503, без остальных двух — просто не регистрируется вебхук.
TELEGRAM_USER_BOT_TOKEN=your_user_bot_token_here   # SECRET
TELEGRAM_USER_BOT_USERNAME=YourBotUsername          # без @, для deep-link t.me/<...>?start=...
# Публичный URL этого бэкенда (Render) — куда Telegram будет слать апдейты.
# Регистрируется автоматически при старте (utils/registerTelegramWebhook.js).
TELEGRAM_WEBHOOK_URL=https://your-backend.onrender.com
# Секрет, который Telegram обязан прислать в заголовке
# X-Telegram-Bot-Api-Secret-Token — защита /telegram/webhook от подделки.
TELEGRAM_WEBHOOK_SECRET=any_random_string_here      # SECRET

# ── Cashera (платёжный шлюз) ────────────────────────────────────────────────
# Личный кабинет Cashera → API-ключи. X-Api-Key на все запросы к их API.
CASHERA_API_KEY=your_cashera_api_key_here     # SECRET, pk_...
# Проверка подлинности POST /webhooks/cashera (заголовки X-Api-Key/X-Secret).
CASHERA_API_SECRET=your_cashera_api_secret_here   # SECRET, sk_...
# Публичный HTTPS URL этого бэкенда + /webhooks/cashera — прод: backend.ebugubkin.ru
CASHERA_CALLBACK_URL=https://your-backend-domain/webhooks/cashera

# ── Smoke test ────────────────────────────────────────────────────────────────
# Учётные данные существующего admin-аккаунта
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password
BACKEND_URL=http://localhost:3001
